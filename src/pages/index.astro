---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Baptiste Blanchard — Accueil">
	<section class="flex sm:flex-row items-center gap-6">
		<img
			src={`${import.meta.env.BASE_URL}/Baptiste-BLANCHARD-165px.png`}
			alt="Portrait de Baptiste Blanchard"
			width="165"
			height="165"
			class="rounded-full shrink-0"
		/>
		<div class="space-y-4">
			<h1 class="text-3xl font-semibold tracking-tight">Bonjour, je suis Baptiste</h1>
			<p class="text-gray-600 max-w-prose">
				La nature pour respirer. La photo pour voir. Un espace à moi, loin du flux.
			</p>
		</div>
	</section>

	<section class="mt-12">
		<a
			href={`${import.meta.env.BASE_URL}/photographie`}
			class="block rounded-xl border border-gray-200 p-6 hover:border-gray-400 transition-colors sm:max-w-sm"
		>
			<h2 class="text-xl font-medium">Photographie</h2>
			<p class="mt-2 text-sm text-gray-600">Dix ans derrière l'objectif en professionnel, aujourd'hui pour le plaisir.</p>
			<p class="mt-2 text-sm text-gray-600">Paysages, architecture, instants de vie — une façon de ralentir dans un monde qui va trop vite.</p>
		</a>
	</section>
</Layout>
