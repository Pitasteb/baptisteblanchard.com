---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import portfolioPhoto from '../assets/photos/portfolio/famille.jpg';
---

<Layout title="Photographie — Baptiste Blanchard">
	<section class="flex flex-col-reverse sm:flex-row items-center gap-8">
		<img
			src={`${import.meta.env.BASE_URL}/photo-boutique-BCARRE-web.jpg`}
			alt="Le studio photo de Baptiste Blanchard aux Sables-d'Olonne"
			class="w-full sm:w-1/4 rounded-xl shrink-0"
		/>
		<div class="space-y-4">
			<h1 class="text-3xl font-semibold tracking-tight">Photographie</h1>
			<p class="text-gray-600 max-w-prose">
				Pendant plusieurs années, j'ai tenu un studio en centre-ville des Sables-d'Olonne,
				spécialisé dans le portrait de famille. Un lieu, des rencontres, des moments.
				Aujourd'hui je photographie pour le plaisir — la plage, la lumière, les scènes de vie
				de ce territoire que j'ai toujours eu envie de regarder de près.
			</p>
		</div>
	</section>

	<section class="mt-16 grid grid-cols-1 sm:grid-cols-2 gap-6">
		<div class="rounded-xl border border-gray-200 overflow-hidden hover:border-gray-400 transition-colors">
			<Image src={portfolioPhoto} alt="" class="w-full h-56 object-cover hover:scale-105 transition-transform" width={600} height={400} />
			<div class="p-8">
				<h2 class="text-xl font-medium">En famille</h2>
				<p class="mt-3 text-sm text-gray-600">
					Quelques séances par an, en extérieur, dans un cadre simple et naturel. Dix
					créneaux maximum — pour garder le temps de bien faire les choses.
				</p>
				<p class="mt-4 text-sm text-gray-400">Book bientôt disponible</p>
			</div>
		</div>

		<div class="rounded-xl border border-gray-200 overflow-hidden hover:border-gray-400 transition-colors">
			<Image src={portfolioPhoto} alt="" class="w-full h-56 object-cover hover:scale-105 transition-transform" width={600} height={400} />
			<div class="p-8">
				<h2 class="text-xl font-medium">Scènes de vie</h2>
				<p class="mt-3 text-sm text-gray-600">
					La rue, les gens, l'instant. Les Sables-d'Olonne tels qu'ils sont.
				</p>
				<p class="mt-4 text-sm text-gray-400">Galerie bientôt disponible</p>
			</div>
		</div>

		<div class="rounded-xl border border-gray-200 overflow-hidden hover:border-gray-400 transition-colors">
			<Image src={portfolioPhoto} alt="" class="w-full h-56 object-cover hover:scale-105 transition-transform" width={600} height={400} />
			<div class="p-8">
				<h2 class="text-xl font-medium">Paysages marins</h2>
				<p class="mt-3 text-sm text-gray-600">
					L'océan, la lumière, le vent. Ce littoral sous toutes ses humeurs.
				</p>
				<p class="mt-4 text-sm text-gray-400">Galerie bientôt disponible</p>
			</div>
		</div>

		<div class="rounded-xl border border-gray-200 overflow-hidden hover:border-gray-400 transition-colors">
			<Image src={portfolioPhoto} alt="" class="w-full h-56 object-cover hover:scale-105 transition-transform" width={600} height={400} />
			<div class="p-8">
				<h2 class="text-xl font-medium">Voyages</h2>
				<p class="mt-3 text-sm text-gray-600">
					D'autres territoires, d'autres lumières. Des images rapportées de là où la route
					m'a mené.
				</p>
				<p class="mt-4 text-sm text-gray-400">Galerie bientôt disponible</p>
			</div>
		</div>
	</section>
</Layout>
